# ============================================
# BHARATVERSE BACKEND — ENVIRONMENT VARIABLES
# Copy this file to .env and fill in real values.
# NEVER commit the real .env file to version control.
# ============================================

# Server
PORT=5000
NODE_ENV=production
CLIENT_ORIGIN=https://bharatverse-puce.vercel.app

# Database
MONGO_URI=mongodb://127.0.0.1:27017/bharatverse

# Auth
JWT_SECRET=replace_this_with_a_long_random_secret
JWT_EXPIRES_IN=7d

# AI (optional — if unset, the AI chat and recognition services
# automatically run in DEMO mode and clearly label themselves as such)
# Put your real API key in a local backend/.env file, not in git-tracked config.
AI_PROVIDER=anthropic
AI_API_KEY=your_api_key_here
AI_MODEL=claude-sonnet-4-6

# Vision / Recognition provider (optional — if unset, recognition
# runs in DEMO mode instead of guessing)
VISION_PROVIDER=
VISION_API_KEY=

# File storage (optional — if unset, uploads are stored on local disk
# under /uploads instead of Cloudinary)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
